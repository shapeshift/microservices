# Security
ACCOUNT_ID_SALT=
# Shared secret required on every request (x-api-key header). Must match across all services and callers.
SERVICE_API_KEY=

# Database Configuration
DATABASE_URL="postgresql://postgres:password@db:5432/microservices"

# Service URLs
SWAP_SERVICE_URL="http://swap-service:3003"
# Server-only Onramper V2 configuration. Register the public key with Onramper.
ONRAMPER_API_KEY=
ONRAMPER_PRIVATE_KEY=
ONRAMPER_API_URL=https://api.onramper.com/
ONRAMPER_WIDGET_URL=https://buy.onramper.com/
ONRAMPER_ALLOWED_ORIGINS=https://app.shapeshift.com
ONRAMPER_REDIRECT_ORIGINS=https://app.shapeshift.com

# Exact socket-peer IPs allowed to supply X-Forwarded-For (empty ignores forwarded headers).
TRUSTED_PROXY_IPS=
