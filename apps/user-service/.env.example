# Security
ACCOUNT_ID_SALT=
# Shared server-only secret for internal routes (x-api-key header). Must match across services.
SERVICE_API_KEY=

# Database Configuration
DATABASE_URL="postgresql://postgres:password@db:5432/microservices"

# Service URLs
SWAP_SERVICE_URL="http://swap-service:3003"
NOTIFICATIONS_SERVICE_URL="http://notifications-service:3003"
# Exact public application origins for device authentication and CORS.
DEVICE_ALLOWED_ORIGINS=https://app.shapeshift.com

# Exact socket-peer IPs allowed to supply X-Forwarded-For (empty ignores forwarded headers).
TRUSTED_PROXY_IPS=
