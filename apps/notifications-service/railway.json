{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn build",
    "watchPatterns": [
      "yarn.lock",
      "apps/notifications-service/**",
      "packages/**",
      "prisma/**"
    ]
  },
  "deploy": {
    "preDeployCommand": "yarn db:migrate",
    "startCommand": "cd apps/notifications-service && yarn start:prod",
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "us-west2": { "numReplicas": 1 }
    }
  }
}
